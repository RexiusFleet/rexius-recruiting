# Copy to .env (gitignored) and fill in. Never commit the real values.
# Session pooler connection string: Dashboard -> Connect -> Session pooler, port 5432.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Only if the runner reports a certificate error: path to the CA certificate downloaded from
# Project Settings -> Database -> SSL Configuration.
# SUPABASE_DB_SSL_CA=/path/to/prod-ca-2021.crt

# Phase 4 backfill (scripts/backfill/README.md). Local stack: SUPABASE_URL=http://127.0.0.1:54321 and
# the service_role key from `npx supabase status`. Hosted: the project URL and the service_role key
# from Project Settings -> API Keys. The service-role key bypasses RLS: scripts and functions only.
# JOTFORM_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# JOTFORM_TIMEZONE=America/Los_Angeles
