# Local values for `npx supabase functions serve --env-file supabase/functions/.env`.
# Copy to supabase/functions/.env (gitignored). Never commit the real file. On the hosted
# project these are Edge Function secrets (README.md step 14), not a file.
#
# Shared secret Jotform sends as ?secret=... on the webhook URL. Any long random string.
JOTFORM_WEBHOOK_SECRET=local-test-secret
# Jotform API key (read-only is enough). For the offline test below leave it as a dummy value.
JOTFORM_API_KEY=not-a-real-key
# Optional. Point at the local stub (scripts/webhook-test/stub-jotform.mjs) to test without
# Jotform; the Edge Runtime runs in Docker, so use host.docker.internal rather than localhost.
JOTFORM_API_BASE=http://host.docker.internal:8787
# Optional. IANA zone the Jotform account is set to (default America/Los_Angeles).
# JOTFORM_TIMEZONE=America/Los_Angeles

# Phase 9a (recruiting-market-check). The Claude Console key from the `recruiting` workspace; a
# dummy value here makes a local run end with the error "Anthropic rejected the API key" stored
# on the market_checks row, which is the error path worth testing without spending anything.
ANTHROPIC_API_KEY_RECRUITING=not-a-real-key
# Shared secret the daily cron job and the "became open" trigger send as x-market-check-secret
# (the same value goes into the vault as recruiting_market_check_secret). Any long random string.
MARKET_CHECK_SECRET=local-market-secret
# Optional: model and web searches per run (defaults claude-opus-5-5 and 6).
# MARKET_CHECK_MODEL=claude-opus-5-5
# MARKET_CHECK_MAX_SEARCHES=6
